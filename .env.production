# Production build (npm run build). Public URLs only, no secrets.
# The Lead Desk API is mounted under /api/v1, so the path must be included here.
VITE_API_BASE_URL=https://leads.colourplus.net/api/v1
# Broadcaster root; the code appends /api/leads, /api/templates, ...
VITE_BROADCAST_API_BASE_URL=https://api-broadcast.colourplus.net
